# Copy this file to a private local environment file or export the variables directly.
# Do not commit real passwords or tokens.
DATABASE_URL=postgres://workload:workload_dev_only@localhost:5432/workload?sslmode=disable
WORKLOAD_HTTP_ADDR=127.0.0.1:8080
WORKLOAD_VIEWER_TOKEN=replace-with-a-local-viewer-token
WORKLOAD_OPERATOR_TOKEN=replace-with-a-different-local-operator-token
WORKLOAD_WORKER_BOOTSTRAP_TOKEN=replace-with-a-third-local-worker-bootstrap-token
WORKLOAD_HEARTBEAT_INTERVAL=5s
WORKLOAD_LEASE_TTL=15s
WORKLOAD_LEASE_REAPER_INTERVAL=1s
WORKLOAD_DISPATCH_LIMIT=100
WORKLOAD_LOG_LEVEL=info
WORKLOAD_LOG_FORMAT=text
WORKLOAD_TRACING_MODE=off
WORKLOAD_TRACING_SERVICE_NAME=workload-server
WORKLOAD_WORKER_TRACING_MODE=off
WORKLOAD_WORKER_TRACING_SERVICE_NAME=workload-worker
WORKLOAD_ALERT_WEBHOOK_URL=
WORKLOAD_ALERT_WEBHOOK_TIMEOUT=1s

# Independent Worker process defaults. Override WORKLOAD_WORKER_NAME per process.
WORKLOAD_SERVER_URL=http://127.0.0.1:8080
WORKLOAD_WORKER_NAME=replace-per-worker
WORKLOAD_WORKER_CONCURRENCY=1
WORKLOAD_WORKER_POLL_MIN=250ms
WORKLOAD_WORKER_POLL_MAX=5s
WORKLOAD_WORKER_HEARTBEAT=5s
WORKLOAD_WORKER_SHUTDOWN_TIMEOUT=30s
WORKLOAD_MOCK_EXECUTION_DELAY=0s
# Docker/Kubernetes 模块 6 使用的仓库内固定任务镜像；构建脚本会生成此本地标签。
WORKLOAD_WORKER_ACTION_IMAGE=workload-action:local

# Optional module 3 real-model adapter. Mock mode does not read these values.
WORKLOAD_MODEL_ENDPOINT=
WORKLOAD_MODEL_NAME=
WORKLOAD_MODEL_API_KEY=
