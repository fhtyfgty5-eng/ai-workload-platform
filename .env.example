# Copy this file to a private local environment file or export the variables directly.
# Do not commit real passwords or tokens.
DATABASE_URL=postgres://workload:workload_dev_only@localhost:5432/workload?sslmode=disable
WORKLOAD_HTTP_ADDR=127.0.0.1:8080
WORKLOAD_VIEWER_TOKEN=replace-with-a-local-viewer-token
WORKLOAD_OPERATOR_TOKEN=replace-with-a-different-local-operator-token
WORKLOAD_LOG_LEVEL=info
WORKLOAD_LOG_FORMAT=text
WORKLOAD_MOCK_EXECUTION_DELAY=0s

# Optional module 3 real-model adapter. Mock mode does not read these values.
WORKLOAD_MODEL_ENDPOINT=
WORKLOAD_MODEL_NAME=
WORKLOAD_MODEL_API_KEY=
